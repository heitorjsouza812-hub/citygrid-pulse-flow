# CityGrid Brain — copie para .env e ajuste somente para a sua demonstração.
# Não use CORS irrestrito em ambiente publicado.
CITYGRID_HOST=127.0.0.1
CITYGRID_PORT=8000
# URL que os celulares conseguem abrir (LAN ou domínio HTTPS); não inclua token.
CITYGRID_PUBLIC_APP_URL=http://127.0.0.1:5173
# Origens exatas, separadas por vírgula. Para LAN inclua http://IP-DO-PC:5173.
CITYGRID_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
# Estado das salas é em memória; execute FastAPI com um único worker.
CITYGRID_ROOM_TTL_MINUTES=120
# Frontend: vazio usa proxy/same-origin. Em deploy separado informe URLs públicas.
VITE_CITYGRID_API_URL=
VITE_CITYGRID_WS_URL=

# Integração opcional Kafka/InfluxDB/Grafana.
CITYGRID_INFLUX_USERNAME=citygrid-admin
CITYGRID_INFLUX_PASSWORD=troque-esta-senha
CITYGRID_INFLUX_TOKEN=troque-este-token-longo
CITYGRID_INFLUX_ORG=citygrid
CITYGRID_INFLUX_BUCKET=citygrid
CITYGRID_GRAFANA_USER=admin
CITYGRID_GRAFANA_PASSWORD=troque-esta-senha
CITYGRID_KAFKA_BOOTSTRAP=localhost:9092
CITYGRID_INFLUX_URL=http://localhost:8086
